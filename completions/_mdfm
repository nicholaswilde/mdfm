'--dry-run[Preview renames without writing files to disk]' \
'--diff[Show unified diff of frontmatter edits]' \
'-l[Print only matching file paths, one per line (shorthand for --output files)]' \
'--files-only[Print only matching file paths, one per line (shorthand for --output files)]' \
'-h[Print help]' \
'--help[Print help]' \
':old_key -- Source dot-separated frontmatter key path (e.g. tag, author.full_name):_default' \
':new_key -- Destination dot-separated frontmatter key path (e.g. tags, author.name):_default' \
'*::paths -- Files or directories to process (defaults to current directory '\''.'\''):_files' \
&& ret=0
;;
(check)
_arguments "${_arguments_options[@]}" : \
'--schema=[Path to JSON Schema file]:SCHEMA:_files' \
'--format=[Frontmatter format used when creating new frontmatter (yaml or toml)]:FORMAT:(yaml toml)' \
'--output=[Output presentation format (table, json, plain, or files)]:OUTPUT:(table json plain files)' \
'--where=[Optional filter expression (e.g. '\''draft == true'\'', '\''not has_frontmatter'\'', '\''frontmatter_format == "toml"'\'', '\''\`prep time\` != null'\'')]:EXPR:_default' \
'-C+[Path to explicit configuration file override (TOML, YAML, or JSON)]:CONFIG:_files' \
'--config=[Path to explicit configuration file override (TOML, YAML, or JSON)]:CONFIG:_files' \
'*--ext=[File extensions to include when walking directories (repeatable or comma-separated; defaults to md,markdown)]:EXT:_default' \
'-q[Show only validation failures and a compact summary line]' \
'--errors-only[Show only validation failures and a compact summary line]' \
'--quiet[Show only validation failures and a compact summary line]' \
'-l[Print only matching file paths, one per line (shorthand for --output files)]' \
'--files-only[Print only matching file paths, one per line (shorthand for --output files)]' \
'-h[Print help]' \
'--help[Print help]' \
'*::paths -- Files or directories to validate (defaults to current directory '\''.'\''):_files' \
&& ret=0
;;
(completions)
_arguments "${_arguments_options[@]}" : \
'--format=[Frontmatter format used when creating new frontmatter (yaml or toml)]:FORMAT:(yaml toml)' \
'--output=[Output presentation format (table, json, plain, or files)]:OUTPUT:(table json plain files)' \
'--where=[Optional filter expression (e.g. '\''draft == true'\'', '\''not has_frontmatter'\'', '\''frontmatter_format == "toml"'\'', '\''\`prep time\` != null'\'')]:EXPR:_default' \
'-C+[Path to explicit configuration file override (TOML, YAML, or JSON)]:CONFIG:_files' \
'--config=[Path to explicit configuration file override (TOML, YAML, or JSON)]:CONFIG:_files' \
'*--ext=[File extensions to include when walking directories (repeatable or comma-separated; defaults to md,markdown)]:EXT:_default' \
'-l[Print only matching file paths, one per line (shorthand for --output files)]' \
'--files-only[Print only matching file paths, one per line (shorthand for --output files)]' \
'-h[Print help]' \
'--help[Print help]' \
':shell -- Target shell:(bash elvish fish powershell zsh)' \
&& ret=0
;;
(man)
_arguments "${_arguments_options[@]}" : \
'--format=[Frontmatter format used when creating new frontmatter (yaml or toml)]:FORMAT:(yaml toml)' \
'--output=[Output presentation format (table, json, plain, or files)]:OUTPUT:(table json plain files)' \
'--where=[Optional filter expression (e.g. '\''draft == true'\'', '\''not has_frontmatter'\'', '\''frontmatter_format == "toml"'\'', '\''\`prep time\` != null'\'')]:EXPR:_default' \
'-C+[Path to explicit configuration file override (TOML, YAML, or JSON)]:CONFIG:_files' \
'--config=[Path to explicit configuration file override (TOML, YAML, or JSON)]:CONFIG:_files' \
'*--ext=[File extensions to include when walking directories (repeatable or comma-separated; defaults to md,markdown)]:EXT:_default' \
'-l[Print only matching file paths, one per line (shorthand for --output files)]' \
'--files-only[Print only matching file paths, one per line (shorthand for --output files)]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(update)
_arguments "${_arguments_options[@]}" : \
'--version=[Target a specific release version or tag (e.g. 0.1.0 or v0.1.0)]:VERSION:_default' \
'--format=[Frontmatter format used when creating new frontmatter (yaml or toml)]:FORMAT:(yaml toml)' \
'--output=[Output presentation format (table, json, plain, or files)]:OUTPUT:(table json plain files)' \
'--where=[Optional filter expression (e.g. '\''draft == true'\'', '\''not has_frontmatter'\'', '\''frontmatter_format == "toml"'\'', '\''\`prep time\` != null'\'')]:EXPR:_default' \
'-C+[Path to explicit configuration file override (TOML, YAML, or JSON)]:CONFIG:_files' \
'--config=[Path to explicit configuration file override (TOML, YAML, or JSON)]:CONFIG:_files' \
'*--ext=[File extensions to include when walking directories (repeatable or comma-separated; defaults to md,markdown)]:EXT:_default' \
'--check[Check for available updates without installing]' \
'-y[Skip confirmation prompt before installing]' \
'--yes[Skip confirmation prompt before installing]' \
'-l[Print only matching file paths, one per line (shorthand for --output files)]' \
'--files-only[Print only matching file paths, one per line (shorthand for --output files)]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_mdfm__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:mdfm-help-command-$line[1]:"
        case $line[1] in
            (get)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(set)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(del)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(mv)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(check)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(completions)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(man)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(update)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_mdfm_commands] )) ||
_mdfm_commands() {
    local commands; commands=(
'get:Query one or more frontmatter keys (dot paths, comma-separated, -k/--key, or '\''.'\'' for full frontmatter)' \
'set:Update, insert, or mutate array frontmatter keys (creates frontmatter using default_format if absent)' \
'del:Delete one or more keys from frontmatter' \
'mv:Rename or merge a frontmatter key across files' \
'rename:Rename or merge a frontmatter key across files' \
'check:Validate frontmatter against a JSON Schema' \
'completions:Generate shell completion scripts (bash, zsh, fish, powershell, elvish)' \
'man:Generate UNIX roff man page' \
'update:Check for and install the latest mdfm release from GitHub' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'mdfm commands' commands "$@"
}
(( $+functions[_mdfm__subcmd__check_commands] )) ||
_mdfm__subcmd__check_commands() {
    local commands; commands=()
    _describe -t commands 'mdfm check commands' commands "$@"
