(( $+functions[_mdfm__subcmd__help__subcmd__check_commands] )) ||
_mdfm__subcmd__help__subcmd__check_commands() {
    local commands; commands=()
    _describe -t commands 'mdfm help check commands' commands "$@"
}
(( $+functions[_mdfm__subcmd__help__subcmd__completions_commands] )) ||
_mdfm__subcmd__help__subcmd__completions_commands() {
    local commands; commands=()
    _describe -t commands 'mdfm help completions commands' commands "$@"
}
(( $+functions[_mdfm__subcmd__help__subcmd__del_commands] )) ||
_mdfm__subcmd__help__subcmd__del_commands() {
    local commands; commands=()
    _describe -t commands 'mdfm help del commands' commands "$@"
}
(( $+functions[_mdfm__subcmd__help__subcmd__get_commands] )) ||
_mdfm__subcmd__help__subcmd__get_commands() {
    local commands; commands=()
    _describe -t commands 'mdfm help get commands' commands "$@"
}
(( $+functions[_mdfm__subcmd__help__subcmd__help_commands] )) ||
_mdfm__subcmd__help__subcmd__help_commands() {
    local commands; commands=()
    _describe -t commands 'mdfm help help commands' commands "$@"
}
(( $+functions[_mdfm__subcmd__help__subcmd__set_commands] )) ||
_mdfm__subcmd__help__subcmd__set_commands() {
    local commands; commands=()
    _describe -t commands 'mdfm help set commands' commands "$@"
}
(( $+functions[_mdfm__subcmd__set_commands] )) ||
_mdfm__subcmd__set_commands() {
    local commands; commands=()
    _describe -t commands 'mdfm set commands' commands "$@"
}

if [ "$funcstack[1]" = "_mdfm" ]; then
    _mdfm "$@"
else
    compdef _mdfm mdfm
fi
