#compdef mdfm

autoload -U is-at-least

_mdfm() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--format=[Frontmatter format used when creating new frontmatter (yaml or toml)]:FORMAT:(yaml toml)' \
'--output=[Output presentation format (table, json, or plain)]:OUTPUT:(table json plain)' \
'--where=[Optional filter expression (e.g. '\''draft == true'\'', '\''author.name == "Nick"'\'', '\''tags contains "rust"'\'')]:EXPR:_default' \
'-C+[Path to explicit configuration file override (TOML, YAML, or JSON)]:CONFIG:_files' \
'--config=[Path to explicit configuration file override (TOML, YAML, or JSON)]:CONFIG:_files' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_mdfm_commands" \
"*::: :->mdfm" \
&& ret=0
    case $state in
    (mdfm)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:mdfm-command-$line[1]:"
        case $line[1] in
            (get)
_arguments "${_arguments_options[@]}" : \
'--format=[Frontmatter format used when creating new frontmatter (yaml or toml)]:FORMAT:(yaml toml)' \
'--output=[Output presentation format (table, json, or plain)]:OUTPUT:(table json plain)' \
'--where=[Optional filter expression (e.g. '\''draft == true'\'', '\''author.name == "Nick"'\'', '\''tags contains "rust"'\'')]:EXPR:_default' \
'-C+[Path to explicit configuration file override (TOML, YAML, or JSON)]:CONFIG:_files' \
'--config=[Path to explicit configuration file override (TOML, YAML, or JSON)]:CONFIG:_files' \
'-h[Print help]' \
'--help[Print help]' \
':key -- Dot-separated frontmatter key path (e.g. title, author.name):_default' \
'*::paths -- Files or directories to search (defaults to current directory '\''.'\''):_files' \
&& ret=0
;;
(set)
_arguments "${_arguments_options[@]}" : \
'--format=[Frontmatter format used when creating new frontmatter (yaml or toml)]:FORMAT:(yaml toml)' \
'--output=[Output presentation format (table, json, or plain)]:OUTPUT:(table json plain)' \
'--where=[Optional filter expression (e.g. '\''draft == true'\'', '\''author.name == "Nick"'\'', '\''tags contains "rust"'\'')]:EXPR:_default' \
'-C+[Path to explicit configuration file override (TOML, YAML, or JSON)]:CONFIG:_files' \
'--config=[Path to explicit configuration file override (TOML, YAML, or JSON)]:CONFIG:_files' \
'--dry-run[Preview changes without writing files to disk]' \
'-h[Print help]' \
'--help[Print help]' \
'*::args -- KEY=VALUE assignments followed by optional file or directory paths (defaults to '\''.'\''):_default' \
&& ret=0
;;
(del)
_arguments "${_arguments_options[@]}" : \
'--format=[Frontmatter format used when creating new frontmatter (yaml or toml)]:FORMAT:(yaml toml)' \
'--output=[Output presentation format (table, json, or plain)]:OUTPUT:(table json plain)' \
'--where=[Optional filter expression (e.g. '\''draft == true'\'', '\''author.name == "Nick"'\'', '\''tags contains "rust"'\'')]:EXPR:_default' \
'-C+[Path to explicit configuration file override (TOML, YAML, or JSON)]:CONFIG:_files' \
'--config=[Path to explicit configuration file override (TOML, YAML, or JSON)]:CONFIG:_files' \
'--dry-run[Preview deletions without writing files to disk]' \
'-h[Print help]' \
'--help[Print help]' \
'*::args -- Frontmatter key paths to delete followed by optional file or directory paths (defaults to '\''.'\''):_default' \
&& ret=0
;;
(check)
_arguments "${_arguments_options[@]}" : \
'--schema=[Path to JSON Schema file]:SCHEMA:_files' \
'--format=[Frontmatter format used when creating new frontmatter (yaml or toml)]:FORMAT:(yaml toml)' \
'--output=[Output presentation format (table, json, or plain)]:OUTPUT:(table json plain)' \
'--where=[Optional filter expression (e.g. '\''draft == true'\'', '\''author.name == "Nick"'\'', '\''tags contains "rust"'\'')]:EXPR:_default' \
'-C+[Path to explicit configuration file override (TOML, YAML, or JSON)]:CONFIG:_files' \
'--config=[Path to explicit configuration file override (TOML, YAML, or JSON)]:CONFIG:_files' \
'-h[Print help]' \
'--help[Print help]' \
'*::paths -- Files or directories to validate (defaults to current directory '\''.'\''):_files' \
&& ret=0
;;
(completions)
_arguments "${_arguments_options[@]}" : \
'--format=[Frontmatter format used when creating new frontmatter (yaml or toml)]:FORMAT:(yaml toml)' \
'--output=[Output presentation format (table, json, or plain)]:OUTPUT:(table json plain)' \
'--where=[Optional filter expression (e.g. '\''draft == true'\'', '\''author.name == "Nick"'\'', '\''tags contains "rust"'\'')]:EXPR:_default' \
'-C+[Path to explicit configuration file override (TOML, YAML, or JSON)]:CONFIG:_files' \
'--config=[Path to explicit configuration file override (TOML, YAML, or JSON)]:CONFIG:_files' \
'-h[Print help]' \
'--help[Print help]' \
':shell -- Target shell:(bash elvish fish powershell zsh)' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_mdfm__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:mdfm-help-command-$line[1]:"
        case $line[1] in
            (get)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(set)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(del)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(check)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(completions)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_mdfm_commands] )) ||
_mdfm_commands() {
    local commands; commands=(
'get:Query a frontmatter key (supports dot paths like author.name) across Markdown files' \
'set:Update or insert frontmatter keys (creates frontmatter using default_format if absent)' \
'del:Delete one or more keys from frontmatter' \
'check:Validate frontmatter against a JSON Schema' \
'completions:Generate shell completion scripts (bash, zsh, fish, powershell, elvish)' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'mdfm commands' commands "$@"
}
(( $+functions[_mdfm__subcmd__check_commands] )) ||
_mdfm__subcmd__check_commands() {
    local commands; commands=()
    _describe -t commands 'mdfm check commands' commands "$@"
}
