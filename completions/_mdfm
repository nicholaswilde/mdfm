#compdef mdfm

autoload -U is-at-least

_mdfm() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--format=[Frontmatter format used when creating new frontmatter (yaml or toml)]:FORMAT:(yaml toml)' \
'--output=[Output presentation format (table, json, plain, or files)]:OUTPUT:(table json plain files)' \
'--where=[Optional filter expression (e.g. '\''draft == true'\'', '\''not has_frontmatter'\'', '\''frontmatter_format == "toml"'\'', '\''\`prep time\` != null'\'')]:EXPR:_default' \
'-C+[Path to explicit configuration file override (TOML, YAML, or JSON)]:CONFIG:_files' \
'--config=[Path to explicit configuration file override (TOML, YAML, or JSON)]:CONFIG:_files' \
'*--ext=[File extensions to include when walking directories (repeatable or comma-separated; defaults to md,markdown)]:EXT:_default' \
'-l[Print only matching file paths, one per line (shorthand for --output files)]' \
'--files-only[Print only matching file paths, one per line (shorthand for --output files)]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_mdfm_commands" \
"*::: :->mdfm" \
&& ret=0
    case $state in
    (mdfm)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:mdfm-command-$line[1]:"
        case $line[1] in
            (get)
_arguments "${_arguments_options[@]}" : \
'*-k+[Frontmatter key(s) to query (repeatable or comma-separated; e.g. -k title -k tags)]:KEY:_default' \
'*--key=[Frontmatter key(s) to query (repeatable or comma-separated; e.g. -k title -k tags)]:KEY:_default' \
'--format=[Frontmatter format used when creating new frontmatter (yaml or toml)]:FORMAT:(yaml toml)' \
'--output=[Output presentation format (table, json, plain, or files)]:OUTPUT:(table json plain files)' \
'--where=[Optional filter expression (e.g. '\''draft == true'\'', '\''not has_frontmatter'\'', '\''frontmatter_format == "toml"'\'', '\''\`prep time\` != null'\'')]:EXPR:_default' \
'-C+[Path to explicit configuration file override (TOML, YAML, or JSON)]:CONFIG:_files' \
'--config=[Path to explicit configuration file override (TOML, YAML, or JSON)]:CONFIG:_files' \
'*--ext=[File extensions to include when walking directories (repeatable or comma-separated; defaults to md,markdown)]:EXT:_default' \
'-l[Print only matching file paths, one per line (shorthand for --output files)]' \
'--files-only[Print only matching file paths, one per line (shorthand for --output files)]' \
'-h[Print help]' \
'--help[Print help]' \
'*::args -- Key selector (e.g. title, author.name, title,tags, or '\''.'\'') followed by optional file or directory paths (defaults to '\''.'\''):_default' \
&& ret=0
;;
(set)
_arguments "${_arguments_options[@]}" : \
'--format=[Frontmatter format used when creating new frontmatter (yaml or toml)]:FORMAT:(yaml toml)' \
'--output=[Output presentation format (table, json, plain, or files)]:OUTPUT:(table json plain files)' \
'--where=[Optional filter expression (e.g. '\''draft == true'\'', '\''not has_frontmatter'\'', '\''frontmatter_format == "toml"'\'', '\''\`prep time\` != null'\'')]:EXPR:_default' \
'-C+[Path to explicit configuration file override (TOML, YAML, or JSON)]:CONFIG:_files' \
'--config=[Path to explicit configuration file override (TOML, YAML, or JSON)]:CONFIG:_files' \
'*--ext=[File extensions to include when walking directories (repeatable or comma-separated; defaults to md,markdown)]:EXT:_default' \
'--dry-run[Preview changes without writing files to disk]' \
'--diff[Show unified diff of frontmatter edits]' \
'-l[Print only matching file paths, one per line (shorthand for --output files)]' \
'--files-only[Print only matching file paths, one per line (shorthand for --output files)]' \
'-h[Print help]' \
'--help[Print help]' \
'*::args -- KEY=VALUE, KEY+=VALUE, or KEY-=VALUE mutations followed by optional file or directory paths (defaults to '\''.'\''):_default' \
&& ret=0
;;
(del)
_arguments "${_arguments_options[@]}" : \
'--format=[Frontmatter format used when creating new frontmatter (yaml or toml)]:FORMAT:(yaml toml)' \
'--output=[Output presentation format (table, json, plain, or files)]:OUTPUT:(table json plain files)' \
'--where=[Optional filter expression (e.g. '\''draft == true'\'', '\''not has_frontmatter'\'', '\''frontmatter_format == "toml"'\'', '\''\`prep time\` != null'\'')]:EXPR:_default' \
'-C+[Path to explicit configuration file override (TOML, YAML, or JSON)]:CONFIG:_files' \
'--config=[Path to explicit configuration file override (TOML, YAML, or JSON)]:CONFIG:_files' \
