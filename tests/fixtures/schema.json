{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["title", "draft"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "draft": { "type": "boolean" },
    "weight": { "type": "integer" },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "author": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" }
      }
    }
  }
}
